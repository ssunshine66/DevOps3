version: '3.8'

services:
  nginx:
    image: nginx:latest
    container_name: nginx-lb
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - srv1
    restart: always

  srv1:
    image: realslimshady1/trig-http-server:multiarch
    container_name: srv1
    ports:
      - "8081:8080"
    cpuset: "0"
    restart: always

  srv2:
    image: realslimshady1/trig-http-server:multiarch
    container_name: srv2
    ports:
      - "8082:8080"
    cpuset: "1"
    restart: always
    deploy:
      replicas: 0

  srv3:
    image: realslimshady1/trig-http-server:multiarch
    container_name: srv3
    ports:
      - "8083:8080"
    cpuset: "2"
    restart: always
    deploy:
      replicas: 0
      